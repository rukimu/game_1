// Text RPG MVP schema
// Default provider is SQLite for zero-config local dev. To use Postgres, set
// DATABASE_URL accordingly and change provider to "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isBanned     Boolean  @default(false)
  characterSlots Int    @default(3)
  createdAt    DateTime @default(now())
  characters   Character[]
  sessions     Session[]
  reportsMade  Report[] @relation("Reporter")
  mutes        Mute[]
  bans         Ban[]
  payments     PaymentTransaction[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id              String   @id @default(cuid())
  userId          String
  name            String   @unique
  level           Int      @default(1)
  exp             Int      @default(0)
  gold            Int      @default(100)
  hp              Int      @default(30)
  maxHp           Int      @default(30)
  mp              Int      @default(10)
  maxMp           Int      @default(10)
  atk             Int      @default(8)
  def             Int      @default(4)
  mat             Int      @default(6)
  mdf             Int      @default(4)
  spd             Int      @default(6)
  luk             Int      @default(5)
  currentTownId   String?
  currentJobId    String?
  isCursed        Boolean  @default(false)
  cosmeticOutfit  String?  // free-form JSON in future
  bio             String?  // auto-generated background story
  quizAnswers     String?  // JSON answers from job quiz
  // Currently-displayed title (slug into Achievement.titleSlug). Players can
  // pick which earned title to wear from /achievements.
  activeTitle     String?
  // First-run progress flag. JSON: { dismissed: boolean, step: number }.
  // Lets the town page show contextual onboarding hints until the player
  // either dismisses them or completes the relevant action.
  tutorialState   String?  @default("{\"dismissed\":false,\"step\":0}")
  // ELO-style duel rating. Starts at 1500; updated each duel via the
  // standard formula in /api/pvp/duels/[id]/accept.
  duelRating      Int      @default(1500)
  // JSON array of Skill ids inherited from past jobs. Slot cap by level
  // (Lv1+: 1, Lv30+: 2, Lv50+: 3). Resolved via src/lib/skillInherit.ts.
  inheritedSkillIds String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory       InventoryItem[]
  jobHistory      CharacterJobHistory[]
  jobMastery      JobMastery[]
  partyMembers    PartyMember[]
  battleParticipants BattleParticipant[]
  guildMember     GuildMember?
  chatMessages    ChatMessage[]
  characterQuests CharacterQuest[]
  tradesA         Trade[] @relation("TradeA")
  tradesB         Trade[] @relation("TradeB")
  auctionListings AuctionListing[]
  auctionBids     AuctionBid[]
  duelsA          Duel[] @relation("DuelA")
  duelsB          Duel[] @relation("DuelB")
  clues           CharacterClue[]
  dungeonRuns     DungeonRun[]
  achievements    CharacterAchievement[]
  masteryQuests   MasteryQuest[]
  dailyChallenges DailyChallenge[]
  raidParticipants RaidParticipant[]
  proficiencies   SkillProficiency[]
}

// World-level achievement definitions. Most are seeded statically; some can
// be created at runtime by world events (e.g. "First to slay [boss-2026-04-29]").
model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String   // "呪縛を解く者", "闘技場の覇者" etc.
  description String
  // Optional title that holders can wear on their HUD.
  titleSlug   String?
  rarity      String   @default("common") // common/rare/epic/legendary/mythic
  hidden      Boolean  @default(false)    // hidden until earned
  createdAt   DateTime @default(now())
  holders     CharacterAchievement[]
}

model CharacterAchievement {
  id              String   @id @default(cuid())
  characterId     String
  achievementId   String
  earnedAt        DateTime @default(now())
  character       Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  @@unique([characterId, achievementId])
}

model Job {
  id           String  @id @default(cuid())
  name         String  @unique
  category     String  // warrior/mage/rogue/cleric/craft/support/heretic/rare/cursed
  rank         String  // beginner/intermediate/advanced/special/legendary/heretic/cursed
  description  String
  isCursed     Boolean @default(false)
  unlockHint   String?
  baseStats    String  // JSON: {atk, def, mat, mdf, spd, hp, mp}
  generatedBy  String  @default("template")
  seasonId     String?
  // Cycle 31: curated jobs are hand-crafted "personalities" (e.g.
  // 眼鏡戦士・パセリ) with their own quirk/outfit/bio. Distinct from
  // procedurally generated jobs which fill the bulk catalog.
  curated      Boolean @default(false)
  quirk        String?  // "眼鏡" / "猫好き" / "甘党" 等のキーワード
  signatureOutfit String?  // 文字列コスメ "丸眼鏡 + 革鎧" 等。C35 のドット絵で置換予定
  signatureBio    String?  // 80-150 字の背景物語、テンプレ bio とは別軸
  pixelArtId      String?  // Cycle 35 (pixel art) 用の参照 ID、現状 null
  createdAt    DateTime @default(now())
  skills       Skill[]
  history      CharacterJobHistory[]
  mastery      JobMastery[]
  questsRequired JobChangeQuest[]
}

model Skill {
  id          String  @id @default(cuid())
  jobId       String?
  name        String
  description String
  type        String  // attack/heal/buff/debuff/special
  element     String? // fire/water/earth/wind/light/dark/none
  power       Int     @default(10)
  cost        Int     @default(0)
  cooldown    Int     @default(0)
  targetType  String  @default("enemy") // enemy/ally/self/all_enemies/all_allies
  generatedBy String  @default("template")
  createdAt   DateTime @default(now())
  job         Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  proficiencies SkillProficiency[]
}

// Per-character usage tally for any skill (current job, past job, or
// inherited slot). Drives the +5/+10/+15% bonus at 10/30/50 uses,
// applied in src/lib/battle.ts via getProficiencyBonusPct.
model SkillProficiency {
  id          String   @id @default(cuid())
  characterId String
  skillId     String
  usageCount  Int      @default(0)
  updatedAt   DateTime @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([characterId, skillId])
  @@index([characterId])
}

model CharacterJobHistory {
  id          String   @id @default(cuid())
  characterId String
  jobId       String
  acquiredAt  DateTime @default(now())
  abandonedAt DateTime?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([characterId, jobId])
}

model JobMastery {
  id          String  @id @default(cuid())
  characterId String
  jobId       String
  mastery     Int     @default(0)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([characterId, jobId])
}

model JobChangeQuest {
  id          String  @id @default(cuid())
  characterId String
  targetJobId String
  description String
  goalType    String   // defeat_enemy/visit_town/level/talk_npc
  goalParam   String?
  goalCount   Int     @default(1)
  progress    Int     @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  targetJob   Job      @relation(fields: [targetJobId], references: [id], onDelete: Cascade)
}

model Enemy {
  id          String  @id @default(cuid())
  name        String
  description String
  level       Int     @default(1)
  hp          Int     @default(30)
  atk         Int     @default(8)
  def         Int     @default(4)
  spd         Int     @default(6)
  element     String? // fire/water/etc
  weakness    String?
  expReward   Int     @default(10)
  goldReward  Int     @default(10)
  generatedBy String  @default("template")
  seasonId    String?
  townId      String?
  createdAt   DateTime @default(now())
}

model Town {
  id           String  @id @default(cuid())
  name         String  @unique
  region       String
  danger       Int     @default(1)
  economy      Int     @default(50)
  security     Int     @default(50)
  innFee       Int     @default(20)
  rumorTrend   String  @default("neutral")
  description  String
  createdAt    DateTime @default(now())
  rumors       TavernRumor[]
  npcs         Npc[]
  quests       Quest[]
  raids        Raid[]
}

model TownState {
  id        String   @id @default(cuid())
  townId    String
  date      String   // YYYY-MM-DD
  payload   String   // JSON
  createdAt DateTime @default(now())
  @@unique([townId, date])
}

model TavernRumor {
  id          String  @id @default(cuid())
  townId      String
  text        String
  generatedBy String  @default("template")
  seasonId    String?
  createdAt   DateTime @default(now())
  town        Town    @relation(fields: [townId], references: [id], onDelete: Cascade)
}

model Npc {
  id          String  @id @default(cuid())
  townId      String
  name        String
  role        String
  dialogue    String
  generatedBy String  @default("template")
  // Most recent visitor — used to color the next visitor's dialogue with
  // "○○もここに来ていたよ" so the NPC feels aware of the world's traffic.
  lastSpokenName  String?
  lastSpokenAt    DateTime?
  visitCount      Int       @default(0)
  createdAt   DateTime @default(now())
  town        Town    @relation(fields: [townId], references: [id], onDelete: Cascade)
}

model Quest {
  id          String  @id @default(cuid())
  townId      String?
  title       String
  description String
  goalType    String   // defeat_enemy/collect_item
  goalParam   String?
  goalCount   Int      @default(1)
  expReward   Int      @default(50)
  goldReward  Int      @default(50)
  generatedBy String   @default("template")
  seasonId    String?
  createdAt   DateTime @default(now())
  town        Town?    @relation(fields: [townId], references: [id], onDelete: SetNull)
  takers      CharacterQuest[]
}

model CharacterQuest {
  id          String   @id @default(cuid())
  characterId String
  questId     String
  progress    Int      @default(0)
  completedAt DateTime?
  acceptedAt  DateTime @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  @@unique([characterId, questId])
}

model Item {
  id          String  @id @default(cuid())
  name        String
  description String
  slot        String? // weapon/head/body/arm/leg/foot/accessory/charm/null for consumable/material
  rarity      String  @default("common")
  category    String  // equip/consumable/material/cosmetic
  // For weapons: sword/greatsword/spear/dagger/bow/staff/rod/drum/flute/hammer/flail.
  // null for non-weapons. Used to look up job affinity bonuses.
  weaponClass String?
  // JSON array of archetype keys (warrior/mage/rogue/cleric/support) that this
  // item is well-suited to. Equipping with a non-affine archetype halves the
  // bonuses. Empty array (or null) = universal.
  jobAffinity String  @default("[]")
  atkBonus    Int     @default(0)
  defBonus    Int     @default(0)
  matBonus    Int     @default(0)
  mdfBonus    Int     @default(0)
  hpBonus     Int     @default(0)
  mpBonus     Int     @default(0)
  tradable    Boolean @default(true)
  cosmetic    Boolean @default(false)
  basePrice   Int     @default(10)
  generatedBy String  @default("template")
  createdAt   DateTime @default(now())
  inventory   InventoryItem[]
  guildStorage GuildStorageItem[]
}

model InventoryItem {
  id          String  @id @default(cuid())
  characterId String
  itemId      String
  quantity    Int      @default(1)
  equipped    Boolean  @default(false)
  // Per-instance hack-and-slash flavor: same Item.id, different actual stats.
  // displayName is the rendered "鋭い 古びた剣 の獣狩り" string. instanceJson
  // carries {affixes: [...], bonusStats: {...}, specials: [...], tier: ...}.
  // Both null = vanilla (e.g. shop purchases, starter potions).
  displayName  String?
  instanceJson String  @default("{}")
  acquiredAt  DateTime @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tradeItems  TradeItem[]
  auctions    AuctionListing[]
}

model Party {
  id           String   @id @default(cuid())
  name         String
  leaderCharacterId String
  description  String?
  isOpen       Boolean  @default(true)
  createdAt    DateTime @default(now())
  members      PartyMember[]
  battles      Battle[]
}

model PartyMember {
  id          String   @id @default(cuid())
  partyId     String
  characterId String   @unique
  joinedAt    DateTime @default(now())
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([partyId, characterId])
}

model Battle {
  id           String   @id @default(cuid())
  partyId      String?
  dungeonRunId String?
  // normal / boss / boss_weekly / duel — drives reward multipliers and announcement text.
  kind         String   @default("normal")
  // Tag for boss-of-the-day or weekly boss so the engine can dedup announcements.
  bossSlug     String?
  // Optional difficulty marker for the weekly tiered boss (1/2/3).
  bossTier     Int?
  status       String   @default("active") // active/ended
  turn         Int      @default(1)
  enemyState   String   // JSON array of enemies w/ hp
  log          String   @default("[]") // JSON array
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  result       String?  // win/lose
  party        Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  dungeonRun   DungeonRun? @relation(fields: [dungeonRunId], references: [id], onDelete: SetNull)
  participants BattleParticipant[]
  actions      BattleAction[]
}

model BattleParticipant {
  id          String   @id @default(cuid())
  battleId    String
  characterId String
  hp          Int
  mp          Int
  joinedTurn  Int      @default(1)
  alive       Boolean  @default(true)
  // JSON array of StatusEffect (poison/burn/stun/silence/bleed/curse) carried
  // across turns. Empty "[]" when the participant has no status.
  statusesJson String  @default("[]")
  battle      Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([battleId, characterId])
}

model BattleAction {
  id          String   @id @default(cuid())
  battleId    String
  turn        Int
  characterId String
  actionType  String   // attack/skill/defend
  targetIndex Int?     // enemy index
  skillId     String?
  resultJson  String?
  createdAt   DateTime @default(now())
  battle      Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
}

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  tag         String?  @unique
  description String   @default("")
  notice      String   @default("")
  masterCharacterId String
  createdAt   DateTime @default(now())
  members     GuildMember[]
  castles     CastleOwnership[]
  storage     GuildStorageItem[]
}

model GuildStorageItem {
  id              String   @id @default(cuid())
  guildId         String
  itemId          String
  quantity        Int      @default(1)
  // Snapshot of the depositing inventory row so per-instance affixes survive.
  // Empty/null mean "vanilla" (e.g. shop-purchased consumables).
  displayName     String?
  instanceJson    String   @default("{}")
  // Audit trail. depositedByCharacterId is informational (no FK relation so
  // characters can be deleted without dropping their guild deposits).
  depositedByCharacterId String?
  depositedAt     DateTime @default(now())
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([guildId])
}

model GuildMember {
  id          String   @id @default(cuid())
  guildId     String
  characterId String   @unique
  role        String   @default("member") // master/sub/member
  joinedAt    DateTime @default(now())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String   @id @default(cuid())
  channel     String   // town:<id>/party:<id>/guild:<id>/dm:<a>:<b>/system
  characterId String?
  senderName  String
  body        String
  createdAt   DateTime @default(now())
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
}

model DirectMessage {
  id          String   @id @default(cuid())
  fromCharacterId String
  toCharacterId   String
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  @@index([fromCharacterId, toCharacterId])
  @@index([toCharacterId, readAt])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  createdAt   DateTime @default(now())
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

model Mute {
  id          String   @id @default(cuid())
  userId      String
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ban {
  id          String   @id @default(cuid())
  userId      String
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedContent {
  id              String   @id @default(cuid())
  type            String   // job/skill/enemy/quest/rumor/npc/dungeon/item
  refId           String?  // related row id once stored
  title           String
  body            String
  structuredJson  String   @default("{}")
  seed            String?
  seasonId        String?
  townId          String?
  characterId     String?
  generatedBy     String   @default("template") // ai/template/admin
  prompt          String?
  model           String?
  validationStatus String  @default("ok")
  disabledAt      DateTime?
  createdAt       DateTime @default(now())
}

model Season {
  id                  String   @id @default(cuid())
  name                String
  startedAt           DateTime @default(now())
  endedAt             DateTime?
  rules               String   @default("{}") // JSON
  isCurrent           Boolean  @default(false)
  // Central mystery for the season — players uncover this collectively.
  mysteryTitle        String?
  mysteryHint         String?
  mysterySolvedAt     DateTime?
  mysterySolverName   String?
  // Auto-rotation: a season ends after `expectedDurationDays` from startedAt
  // OR 7 days after mysterySolvedAt, whichever comes first. Set to 0 to opt
  // out of auto-rotation (legacy seasons).
  expectedDurationDays Int     @default(30)
  clues               SeasonClue[]
}

model SeasonClue {
  id        String  @id @default(cuid())
  seasonId  String
  orderIdx  Int
  text      String
  hint      String?
  isFinal   Boolean @default(false)
  createdAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  finds     CharacterClue[]
}

model CharacterClue {
  id          String   @id @default(cuid())
  characterId String
  clueId      String
  source      String?  // rumor/battle/dungeon/npc
  foundAt     DateTime @default(now())
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  clue        SeasonClue @relation(fields: [clueId], references: [id], onDelete: Cascade)
  @@unique([characterId, clueId])
}

model DungeonRun {
  id              String   @id @default(cuid())
  characterId     String
  partyId         String?
  name            String
  // Optional themed dungeon key (library/tower/lake/altar/bell). When set,
  // the run uses the matching enemy bias, boss, and loot table on its
  // final floor. Null = procedural generic run.
  theme           String?
  totalFloors     Int
  currentFloor    Int      @default(0)
  status          String   @default("active") // active/cleared/aborted/dead
  accumulatedExp  Int      @default(0)
  accumulatedGold Int      @default(0)
  rewardLog       String   @default("[]")
  currentBattleId String?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  battles         Battle[]
}

model WorldState {
  id          String   @id @default(cuid())
  date        String   @unique
  payload     String   // JSON
  createdAt   DateTime @default(now())
}

// Mastery quests: per-job-category long-term progression. Three tiers per
// archetype (Lv15 / Lv30 / Lv45 unlocks). Completing all three of your
// current category yields a permanent stat boost + a unique title.
model MasteryQuest {
  id              String   @id @default(cuid())
  characterId     String
  jobCategory     String   // warrior/mage/rogue/cleric/support/...
  tier            Int      // 1, 2, 3
  goalType        String   // defeat_enemy / win_battles / use_skill_count / clear_themed_dungeon / explore_towns
  goalParam       String?
  goalCount       Int
  progress        Int      @default(0)
  completedAt     DateTime?
  rewardGold      Int      @default(0)
  rewardExp       Int      @default(0)
  // Optional title slug to award via Achievement system on completion.
  rewardTitleSlug String?
  // Optional permanent stat reward, "atk:2" / "mat:3" / "def:2" etc.
  rewardStat      String?
  acceptedAt      DateTime @default(now())
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([characterId, jobCategory, tier])
  @@index([characterId, completedAt])
}

// World raid bosses. Spawn lazily in towns; players have 10 minutes to
// gather, then the combat phase opens for up to 30 minutes. Async DPS race
// — every player has individual cooldowns. Contribution ranking drives the
// reward distribution.
model Raid {
  id            String   @id @default(cuid())
  townId        String?
  name          String
  description   String   @default("")
  level         Int      @default(20)
  maxHp         Int
  hp            Int
  atk           Int      @default(20)
  defense       Int      @default(10)
  element       String?
  weakness      String?
  creatureType  String   @default("magic")
  // joining = open for sign-up, active = combat phase, ended = resolved
  status        String   @default("joining")
  result        String?  // victory / expired / cancelled
  startsAt      DateTime @default(now())
  joinDeadline  DateTime
  combatEndsAt  DateTime
  endedAt       DateTime?
  // JSON list of { characterId, name, damage, healing, rewardTier, drop } — generated on finalize.
  rewardsJson   String   @default("[]")
  // Combat log: [{ at, actor, line }] — recent N entries kept.
  combatLogJson String   @default("[]")
  createdAt     DateTime @default(now())
  town          Town?    @relation(fields: [townId], references: [id], onDelete: SetNull)
  participants  RaidParticipant[]
  @@index([status])
  @@index([townId, status])
}

model RaidParticipant {
  id              String   @id @default(cuid())
  raidId          String
  characterId     String
  joinedAt        DateTime @default(now())
  hp              Int      @default(0)
  maxHp           Int      @default(0)
  mp              Int      @default(0)
  maxMp           Int      @default(0)
  damageDealt     Int      @default(0)
  healingDone     Int      @default(0)
  // Ms-precision millisecond timestamps for cooldown gates. Compared against
  // Date.now() at action time. attack (5s), skill (15s), heal (10s).
  attackReadyAt   BigInt   @default(0)
  skillReadyAt    BigInt   @default(0)
  healReadyAt     BigInt   @default(0)
  alive           Boolean  @default(true)
  // KO recovery: if downed (alive=false), revives at this timestamp (Date.now() + 90s).
  reviveAt        BigInt   @default(0)
  raid            Raid     @relation(fields: [raidId], references: [id], onDelete: Cascade)
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([raidId, characterId])
  @@index([raidId, damageDealt])
}

// Daily challenges: 3 randomized objectives per character per day. Cleared
// objectives stack a small bonus; clearing all three on a given day awards
// a daily bonus chest.
model DailyChallenge {
  id              String   @id @default(cuid())
  characterId     String
  date            String   // YYYY-MM-DD
  slotIndex       Int      // 0..2
  goalType        String   // defeat_enemy / win_battles / spend_gold / drop_gear / clear_dungeon
  goalParam       String?
  goalCount       Int
  progress        Int      @default(0)
  completedAt     DateTime?
  rewardExp       Int      @default(0)
  rewardGold      Int      @default(0)
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([characterId, date, slotIndex])
  @@index([characterId, date])
}

model Castle {
  id          String   @id @default(cuid())
  name        String   @unique
  region      String
  description String
  ownerships  CastleOwnership[]
  sieges      SiegeEvent[]
}

model CastleOwnership {
  id          String   @id @default(cuid())
  castleId    String
  guildId     String
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  castle      Castle   @relation(fields: [castleId], references: [id], onDelete: Cascade)
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model SiegeEvent {
  id          String   @id @default(cuid())
  castleId    String
  // pending = registration window open; active = combat phase; ended = resolved.
  status      String   @default("pending")
  startsAt    DateTime
  endedAt     DateTime?
  // Winning guild — null until ended.
  winningGuildId String?
  result      String?
  // Narrative blow-by-blow generated at resolution time so the siege page can
  // show what actually happened rather than just the final score. JSON array
  // of { round, line }. Empty "[]" while pending/active.
  battleLogJson String  @default("[]")
  castle      Castle   @relation(fields: [castleId], references: [id], onDelete: Cascade)
  registrations SiegeRegistration[]
  // Cycle 32: real-time interactive battle attached to the active phase.
  // Null until startSiegeBattle runs; one-to-one.
  battle      SiegeBattle?
}

// Cycle 32: real-time siege battle state. One per SiegeEvent. Replaces the
// score-only narrative resolution with turn-based player intervention.
model SiegeBattle {
  id            String    @id @default(cuid())
  siegeId       String    @unique
  status        String    @default("lobby")  // lobby / active / resolved
  turn          Int       @default(0)
  turnEndsAt    DateTime?
  winningGuildId String?
  // Per-guild "ギルマス号令" once-per-battle tracker. JSON: { [guildId]: true }.
  rallyUsedJson String    @default("{}")
  // Per-guild "サブ治療" once-per-battle tracker. JSON: { [guildId]: true }.
  cureUsedJson  String    @default("{}")
  // Combat log array { turn, kind, line }, trimmed to last 100.
  logJson       String    @default("[]")
  // Per-guild buffs active for the current turn (rally boost). Reset on resolve.
  buffsJson     String    @default("{}")
  createdAt     DateTime  @default(now())
  siege         SiegeEvent @relation(fields: [siegeId], references: [id], onDelete: Cascade)
  states        SiegeBattleGuildState[]
  actions       SiegeBattleAction[]
}

model SiegeBattleGuildState {
  id            String   @id @default(cuid())
  siegeBattleId String
  guildId       String
  hp            Int
  maxHp         Int
  alive         Boolean  @default(true)
  // Member snapshot at battle start: [{ characterId, name, level, wins, role }].
  membersJson   String
  battle        SiegeBattle @relation(fields: [siegeBattleId], references: [id], onDelete: Cascade)
  @@unique([siegeBattleId, guildId])
}

model SiegeBattleAction {
  id            String   @id @default(cuid())
  siegeBattleId String
  characterId   String
  guildId       String
  turn          Int
  // attack / aoe / heavy / support / rally / cure
  actionType    String
  targetGuildId String?
  createdAt     DateTime @default(now())
  battle        SiegeBattle @relation(fields: [siegeBattleId], references: [id], onDelete: Cascade)
  @@unique([siegeBattleId, turn, characterId])
  @@index([siegeBattleId, turn])
}

model SiegeRegistration {
  id          String   @id @default(cuid())
  siegeId     String
  guildId     String
  // Aggregate "battle score" the guild earned during the active phase. For
  // MVP this is just the sum of member level + lifetime wins, snapshotted on
  // resolve. Higher = closer to taking the castle.
  score       Int      @default(0)
  registeredAt DateTime @default(now())
  siege       SiegeEvent @relation(fields: [siegeId], references: [id], onDelete: Cascade)
  @@unique([siegeId, guildId])
}

model Trade {
  id          String   @id @default(cuid())
  fromCharacterId String
  toCharacterId   String
  status      String   @default("pending") // pending/accepted/cancelled
  offerGold   Int      @default(0)
  requestGold Int      @default(0)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  from        Character @relation("TradeA", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  to          Character @relation("TradeB", fields: [toCharacterId], references: [id], onDelete: Cascade)
  items       TradeItem[]
}

model TradeItem {
  id              String   @id @default(cuid())
  tradeId         String
  side            String   // offer/request
  inventoryItemId String
  quantity        Int      @default(1)
  trade           Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  invItem         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model AuctionListing {
  id              String   @id @default(cuid())
  sellerCharacterId String
  inventoryItemId String
  startPrice      Int
  buyoutPrice     Int?
  currentBid      Int      @default(0)
  currentBidderId String?
  endsAt          DateTime
  status          String   @default("active") // active/sold/cancelled/expired
  createdAt       DateTime @default(now())
  seller          Character @relation(fields: [sellerCharacterId], references: [id], onDelete: Cascade)
  invItem         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  bids            AuctionBid[]
}

model AuctionBid {
  id          String   @id @default(cuid())
  listingId   String
  bidderCharacterId String
  amount      Int
  createdAt   DateTime @default(now())
  listing     AuctionListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder      Character @relation(fields: [bidderCharacterId], references: [id], onDelete: Cascade)
}

model Duel {
  id          String   @id @default(cuid())
  challengerCharacterId String
  opponentCharacterId   String
  status      String   @default("pending") // pending/accepted/finished/declined
  winnerCharacterId String?
  log         String   @default("[]")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  challenger  Character @relation("DuelA", fields: [challengerCharacterId], references: [id], onDelete: Cascade)
  opponent    Character @relation("DuelB", fields: [opponentCharacterId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  currency    String   @default("JPY")
  productCode String
  status      String   @default("paid") // paid/refunded
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorType   String   // user/system/admin
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  payload     String   @default("{}")
  createdAt   DateTime @default(now())
}
