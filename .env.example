# Database (default = SQLite, no docker required)
DATABASE_URL="file:./dev.db"

# Auth secret for session cookies (change in production)
AUTH_SECRET="dev-secret-change-me-please"

# Server port
PORT=3000

# Optional AI provider (leave blank to use template generation)
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
AI_PROVIDER="template"

# Admin seed credentials (for local dev only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"
